    <string name="access_steps_title">Настройка помощника</string>
    <string name="access_step1">Включите «Для разработчиков» и «Отладку по Wi-Fi».</string>
    <string name="access_step2">Нажмите «Настроить помощника» — откроются настройки разработчика.</string>
