    <string name="access_title">Hotspot helper</string>
    <string name="access_intro_title">Why a helper?</string>
    <string name="access_intro">Android 16 does not let ordinary apps turn on the system hotspot. Hotspot Toggler starts a small helper through the phone\'s debugging. Wireless debugging is needed only to start or restart the helper: after that it can be turned off. Keep USB debugging on — it stops Android from killing the helper. No root, no Shizuku, no PC after setup.</string>
